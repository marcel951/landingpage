---
import {
  siC,
  siCisco,
  siDocker,
  siGit,
  siGitlab,
  siJavascript,
  siJetbrains,
  siKubernetes,
  siLinux,
  siMacos,
  siOpenjdk,
  siProxmox,
  siPython,
  siTypescript,
  siVmware,
  siVuedotjs,
} from 'simple-icons';
import TechItem from '../components/TechItem.astro';
import '../styles/global.css';

const githubUrl = 'https://github.com/marcel951';
const linkedinUrl = 'https://www.linkedin.com/in/marcel-kaiser-86a9b9237/';
const emailAddress = '';
const currentYear = new Date().getFullYear();

const techGroups = [
  {
    name: 'Betriebssysteme',
    items: [
      { name: 'Linux', logo: siLinux },
      { name: 'Windows', short: 'Win' },
      { name: 'macOS', logo: siMacos },
    ],
  },
  {
    name: 'Infrastruktur & Netzwerk',
    items: [
      { name: 'Proxmox VE', logo: siProxmox },
      { name: 'VMware / ESXi', logo: siVmware },
      { name: 'Hypervisor', short: 'HV' },
      { name: 'Cisco', logo: siCisco },
      { name: 'Sophos', short: 'S' },
      { name: 'Sophos Mobile', short: 'SM' },
    ],
  },
  {
    name: 'Automation & Management',
    items: [
      { name: 'Power Automate', short: 'PA' },
      { name: 'Matrix42', short: 'M42' },
      { name: 'Active Directory', short: 'AD' },
    ],
  },
  {
    name: 'Entwicklung & Plattformen',
    items: [
      { name: 'Java', logo: siOpenjdk },
      { name: 'Python', logo: siPython },
      { name: 'C', logo: siC },
      { name: 'Lean 4', short: 'λ' },
      { name: 'TypeScript', logo: siTypescript },
      { name: 'JavaScript', logo: siJavascript },
      { name: 'Vue.js', logo: siVuedotjs },
      { name: 'Docker', logo: siDocker },
      { name: 'Kubernetes', logo: siKubernetes },
      { name: 'Git', logo: siGit },
      { name: 'GitLab', logo: siGitlab },
      { name: 'JetBrains', logo: siJetbrains },
    ],
  },
];

const projects = [
  {
    number: '01',
    type: 'Lean-4-Bibliothek',
    name: 'Leansi',
    description:
      'Eine Bibliothek für lesbare Terminalausgaben in Lean 4. Sie verbindet strukturierte Dokumente mit ANSI-Farben, Ausrichtung, tabellarischen Layouts, Terminalerkennung und Fortschrittsanzeigen.',
    technologies: ['Lean 4', 'Lake', 'GitHub Actions'],
    url: 'https://github.com/marcel951/Leansi',
  },
  {
    number: '02',
    type: 'Teamprojekt · Secure Software Engineering',
    name: 'Noteify',
    description:
      'Eine browserbasierte Notiz-Anwendung mit privaten und öffentlichen Notizen. Das abgeschlossene Hochschulprojekt kombiniert ein Angular-Frontend mit Node.js, MariaDB und einer containerisierten Infrastruktur.',
    technologies: ['Angular', 'TypeScript', 'Node.js', 'MariaDB', 'Docker'],
    url: 'https://github.com/marcel951/Noteify',
  },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Marcel Kaiser — Informatiker und Fachinformatiker für Systemintegration mit Erfahrung in Infrastruktur, Administration und Softwareentwicklung."
    />
    <meta name="theme-color" content="#f5f5f2" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content="Marcel Kaiser — Informatik & Systemintegration" />
    <meta
      property="og:description"
      content="Portfolio über Systemintegration, IT-Infrastruktur und Softwareentwicklung."
    />
    <meta property="og:url" content="https://kaiser-marcel.de" />
    <link rel="canonical" href="https://kaiser-marcel.de" />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <link rel="manifest" href="./site.webmanifest" />
    <title>Marcel Kaiser — Informatik & Systemintegration</title>
    <script is:inline>
      const preferredTheme = 'light';
      document.documentElement.classList.add('js');

      try {
        const savedTheme = localStorage.getItem('theme');
        document.documentElement.dataset.theme = savedTheme || preferredTheme;
      } catch {
        document.documentElement.dataset.theme = preferredTheme;
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>

    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Marcel Kaiser – Startseite">
        <span class="wordmark__name">Marcel Kaiser</span>
        <span class="wordmark__role">Informatik</span>
      </a>

      <nav class="main-nav" aria-label="Hauptnavigation">
        <a href="#profil">Profil</a>
        <a href="#tech-stack">Tech-Stack</a>
        <a href="#projekte">Projekte</a>
      </nav>

      <button class="theme-toggle" type="button" aria-label="Farbschema wechseln">
        <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.5 8.5 0 1 0 20.2 15.1Z"></path>
        </svg>
      </button>
    </header>

    <main id="main">
      <section class="hero" id="top">
        <div class="hero__copy">
          <p class="eyebrow reveal" data-reveal>Persönliches Portfolio</p>
          <h1 class="reveal" data-reveal>Marcel<br />Kaiser</h1>
          <p class="hero__role reveal" data-reveal>Informatik · Systemintegration</p>
          <p class="hero__intro reveal" data-reveal>
            Ich verbinde langjährige Praxiserfahrung in der Systemintegration mit einem
            Informatikstudium und einem ganzheitlichen Blick auf moderne IT-Systeme.
          </p>
          <div class="hero__actions reveal" data-reveal>
            <a class="button" href="#profil">Mehr erfahren <span aria-hidden="true">↓</span></a>
            <a class="text-link" href={githubUrl} target="_blank" rel="me noreferrer">
              GitHub <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href={linkedinUrl} target="_blank" rel="me noreferrer">
              LinkedIn <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="math-field" aria-hidden="true">
          <canvas data-math-field></canvas>
          <div class="math-field__formula math-field__formula--euler">e<sup>iπ</sup> + 1 = 0</div>
          <div class="math-field__formula math-field__formula--fibonacci">F<sub>n</sub> = F<sub>n−1</sub> + F<sub>n−2</sub></div>
          <div class="math-field__formula math-field__formula--golden">φ = (1 + √5) / 2</div>
          <div class="math-field__constants"><span>π</span><span>e</span><span>φ</span><span>√2</span></div>
        </div>
        <div class="theme-wave" data-theme-wave aria-hidden="true"></div>

        <div class="hero__footer reveal" data-reveal>
          <span>Systemintegration</span>
          <span>Infrastruktur</span>
          <span>Entwicklung</span>
          <span>{currentYear}</span>
        </div>
      </section>

      <section class="profile section" id="profil">
        <div class="section-label reveal" data-reveal><span>01</span><p>Profil</p></div>

        <div class="profile__content">
          <h2 class="reveal" data-reveal>Praxis trifft Informatik.</h2>
          <div class="profile__text reveal" data-reveal>
            <p>
              Nach meiner Ausbildung zum Fachinformatiker für Systemintegration habe ich
              langjährige Berufserfahrung im Betrieb und in der Betreuung von IT-Systemen
              gesammelt – insbesondere in der Energiebranche und im Umfeld kommunaler
              Versorgungsunternehmen. Ergänzend dazu habe ich Informatik studiert und vertiefe
              meine Kenntnisse nach dem Bachelorabschluss derzeit im Masterstudium.
            </p>
            <p>
              Mein Schwerpunkt liegt an der Schnittstelle zwischen Infrastruktur,
              Administration und Softwareentwicklung. Dazu gehören unter anderem virtuelle
              Umgebungen, Datenbanksysteme, Gerätemanagement, Anwendungsbetreuung und
              IT-Projektarbeit.
            </p>
          </div>
        </div>

        <div class="career-timeline" data-timeline aria-label="Mein beruflicher Weg">
          <div class="career-timeline__track" aria-hidden="true"><span></span></div>
          <ol>
            <li class="career-step" data-timeline-step>
              <span class="career-step__number">01</span>
              <p class="career-step__phase">Fundament</p>
              <h3>Ausbildung</h3>
              <p>Fachinformatiker für Systemintegration</p>
            </li>
            <li class="career-step" data-timeline-step>
              <span class="career-step__number">02</span>
              <p class="career-step__phase">Praxis</p>
              <h3>Systemintegration</h3>
              <p>IT-Betrieb und Projekte in der Energiebranche</p>
            </li>
            <li class="career-step" data-timeline-step>
              <span class="career-step__number">03</span>
              <p class="career-step__phase">Vertiefung</p>
              <h3>Bachelor Informatik</h3>
              <p>Softwareentwicklung und Informatik</p>
            </li>
            <li class="career-step" data-timeline-step>
              <span class="career-step__number">04</span>
              <p class="career-step__phase">Heute</p>
              <h3>Masterstudium</h3>
              <p>Weitere fachliche Spezialisierung</p>
            </li>
          </ol>
        </div>
      </section>

      <section class="tech section" id="tech-stack">
        <div class="section-label reveal" data-reveal><span>02</span><p>Tech-Stack</p></div>

        <div class="tech__heading">
          <h2 class="reveal" data-reveal>Technologien & Werkzeuge</h2>
          <p class="reveal" data-reveal>
            Eine Auswahl der Systeme, Plattformen und Sprachen, mit denen ich arbeite.
          </p>
        </div>

        <div class="tech-groups">
          {techGroups.map((group) => (
            <section class="tech-group reveal" data-reveal>
              <h3>{group.name}</h3>
              <ul class="tech-list">
                {group.items.map((item) => <TechItem {...item} />)}
              </ul>
            </section>
          ))}
        </div>
      </section>

      <section class="projects section" id="projekte">
        <div class="section-label reveal" data-reveal><span>03</span><p>Projekte</p></div>

        <div class="projects__heading">
          <h2 class="reveal" data-reveal>Ausgewählte Arbeiten</h2>
          <a class="text-link reveal" data-reveal href={githubUrl} target="_blank" rel="me noreferrer">
            Alle Repositories <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="project-list">
          {projects.map((project) => (
            <article class="project reveal" data-reveal>
              <div class="project__meta">
                <span>{project.number}</span>
                <span>{project.type}</span>
              </div>
              <div class="project__content">
                <h3>{project.name}</h3>
                <p>{project.description}</p>
                <ul aria-label={`Technologien für ${project.name}`}>
                  {project.technologies.map((technology) => <li>{technology}</li>)}
                </ul>
              </div>
              <a
                class="project__link"
                href={project.url}
                target="_blank"
                rel="noreferrer"
                aria-label={`${project.name} auf GitHub öffnen`}
              >
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="contact section" id="kontakt">
        <div class="section-label reveal" data-reveal><span>04</span><p>Kontakt</p></div>

        <div class="contact__content">
          <h2 class="reveal" data-reveal>Interesse an einem Austausch?</h2>
          <div class="reveal" data-reveal>
            <p>Am einfachsten erreichst du mich über LinkedIn oder GitHub.</p>
            <div class="contact__links">
              <a class="text-link" href={linkedinUrl} target="_blank" rel="me noreferrer">
                LinkedIn <span aria-hidden="true">↗</span>
              </a>
              <a class="text-link" href={githubUrl} target="_blank" rel="me noreferrer">
                GitHub <span aria-hidden="true">↗</span>
              </a>
              {
                emailAddress && (
                  <a class="text-link" href={`mailto:${emailAddress}`}>
                    E-Mail <span aria-hidden="true">↗</span>
                  </a>
                )
              }
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>© {currentYear} Marcel Kaiser</p>
      <p>kaiser-marcel.de</p>
      <a href="#top">Nach oben ↑</a>
    </footer>

    <script>
      const root = document.documentElement;
      const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      const themeWave = document.querySelector<HTMLElement>('[data-theme-wave]');

      const updateThemeMeta = () => {
        themeMeta?.setAttribute('content', root.dataset.theme === 'dark' ? '#171816' : '#f5f5f2');
      };

      themeToggle?.addEventListener('click', () => {
        const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = nextTheme;
        localStorage.setItem('theme', nextTheme);
        updateThemeMeta();
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && themeWave) {
          themeWave.classList.remove('is-active');
          void themeWave.offsetWidth;
          themeWave.classList.add('is-active');
        }
      });

      updateThemeMeta();

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 },
      );

      document.querySelectorAll('[data-reveal]').forEach((element) => revealObserver.observe(element));

      const timeline = document.querySelector<HTMLElement>('[data-timeline]');
      const timelineSteps = document.querySelectorAll<HTMLElement>('[data-timeline-step]');
      const timelineObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const step = entry.target as HTMLElement;
            step.classList.add('is-active');
            timeline?.style.setProperty('--timeline-progress', `${Number(step.dataset.step) + 1}`);
            timelineObserver.unobserve(step);
          });
        },
        { threshold: 0.55 },
      );

      timelineSteps.forEach((step, index) => {
        step.dataset.step = String(index);
        timelineObserver.observe(step);
      });

      const mathCanvas = document.querySelector<HTMLCanvasElement>('[data-math-field]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (mathCanvas) {
        const context = mathCanvas.getContext('2d');
        const constants = [Math.PI, Math.E, (1 + Math.sqrt(5)) / 2, Math.SQRT2];
        let width = 0;
        let height = 0;
        let frame = 0;
        let points: Array<{ x: number; y: number; vx: number; vy: number; baseVx: number; baseVy: number }> = [];
        const pointer = { x: 0, y: 0, active: false };

        const circumcircle = (a: typeof points[number], b: typeof points[number], c: typeof points[number]) => {
          const d = 2 * (a.x * (b.y - c.y) + b.x * (c.y - a.y) + c.x * (a.y - b.y));
          if (Math.abs(d) < 0.001) return { x: 0, y: 0, radiusSquared: -1 };
          const a2 = a.x ** 2 + a.y ** 2;
          const b2 = b.x ** 2 + b.y ** 2;
          const c2 = c.x ** 2 + c.y ** 2;
          const x = (a2 * (b.y - c.y) + b2 * (c.y - a.y) + c2 * (a.y - b.y)) / d;
          const y = (a2 * (c.x - b.x) + b2 * (a.x - c.x) + c2 * (b.x - a.x)) / d;
          return { x, y, radiusSquared: (x - a.x) ** 2 + (y - a.y) ** 2 };
        };

        const triangulate = () => {
          const margin = Math.max(width, height) * 10;
          const vertices = [...points,
            { x: -margin, y: height + margin, vx: 0, vy: 0, baseVx: 0, baseVy: 0 },
            { x: width / 2, y: -margin, vx: 0, vy: 0, baseVx: 0, baseVy: 0 },
            { x: width + margin, y: height + margin, vx: 0, vy: 0, baseVx: 0, baseVy: 0 },
          ];
          let triangles = [[points.length, points.length + 1, points.length + 2]];

          points.forEach((point, pointIndex) => {
            const bad = triangles.filter(([a, b, c]) => {
              const circle = circumcircle(vertices[a], vertices[b], vertices[c]);
              return circle.radiusSquared >= 0 && (point.x - circle.x) ** 2 + (point.y - circle.y) ** 2 < circle.radiusSquared;
            });
            const edges: Array<[number, number]> = [];
            bad.forEach(([a, b, c]) => edges.push([a, b], [b, c], [c, a]));
            triangles = triangles.filter((triangle) => !bad.includes(triangle));
            const boundary = edges.filter(([a, b], index) =>
              !edges.some(([c, d], other) => other !== index && a === d && b === c),
            );
            boundary.forEach(([a, b]) => triangles.push([a, b, pointIndex]));
          });

          return triangles.filter((triangle) => triangle.every((index) => index < points.length));
        };

        const drawMathField = () => {
          if (!context) return;
          context.clearRect(0, 0, width, height);
          const accent = getComputedStyle(root).getPropertyValue('--accent').trim();
          const triangles = triangulate();

          triangles.forEach(([a, b, c], index) => {
            context.beginPath();
            context.moveTo(points[a].x, points[a].y);
            context.lineTo(points[b].x, points[b].y);
            context.lineTo(points[c].x, points[c].y);
            context.closePath();
            context.strokeStyle = accent;
            context.globalAlpha = 0.12;
            context.lineWidth = 0.8;
            context.stroke();
            if (index % 7 === 0) {
              context.globalAlpha = 0.025 + Math.sin(frame / 90 + index) * 0.01;
              context.fillStyle = accent;
              context.fill();
            }
          });

          context.globalAlpha = 0.38;
          context.fillStyle = accent;
          points.forEach((point, index) => {
            context.beginPath();
            context.arc(point.x, point.y, index % 5 === 0 ? 2.2 : 1.4, 0, Math.PI * 2);
            context.fill();
          });
          context.globalAlpha = 1;
        };

        const animateMathField = () => {
          frame += 1;
          points.forEach((point) => {
            if (pointer.active) {
              const dx = pointer.x - point.x;
              const dy = pointer.y - point.y;
              const distance = Math.hypot(dx, dy);
              if (distance < 220 && distance > 1) {
                const force = (1 - distance / 220) * 0.012;
                point.vx += (dx / distance) * force;
                point.vy += (dy / distance) * force;
              }
            } else {
              point.vx += (point.baseVx - point.vx) * 0.025;
              point.vy += (point.baseVy - point.vy) * 0.025;
            }
            point.vx = Math.max(-0.42, Math.min(0.42, point.vx));
            point.vy = Math.max(-0.42, Math.min(0.42, point.vy));
            point.x += point.vx;
            point.y += point.vy;
            if (point.x < 0 || point.x > width) {
              point.vx *= -1;
              point.baseVx *= -1;
            }
            if (point.y < 0 || point.y > height) {
              point.vy *= -1;
              point.baseVy *= -1;
            }
          });
          drawMathField();
          if (!reducedMotion.matches) requestAnimationFrame(animateMathField);
        };

        const resizeMathField = () => {
          const bounds = mathCanvas.getBoundingClientRect();
          width = bounds.width;
          height = bounds.height;
          const ratio = Math.min(window.devicePixelRatio, 2);
          mathCanvas.width = width * ratio;
          mathCanvas.height = height * ratio;
          context?.setTransform(ratio, 0, 0, ratio, 0, 0);
          points = Array.from({ length: width < 600 ? 12 : 20 }, (_, index) => {
            const value = constants[index % constants.length];
            const baseVx = Math.cos(value * (index + 1)) * 0.12;
            const baseVy = Math.sin(value * (index + 1)) * 0.12;
            return {
              x: ((index * 0.61803398875 + value) % 1) * width,
              y: ((index * value * 0.137 + constants[(index + 1) % constants.length]) % 1) * height,
              vx: baseVx,
              vy: baseVy,
              baseVx,
              baseVy,
            };
          });
          drawMathField();
        };

        new ResizeObserver(resizeMathField).observe(mathCanvas);
        new MutationObserver(drawMathField).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
        const hero = mathCanvas.closest<HTMLElement>('.hero');
        hero?.addEventListener('pointermove', (event) => {
          if (reducedMotion.matches) return;
          const bounds = mathCanvas.getBoundingClientRect();
          pointer.x = event.clientX - bounds.left;
          pointer.y = event.clientY - bounds.top;
          pointer.active = true;
        });
        hero?.addEventListener('pointerleave', () => (pointer.active = false));
        resizeMathField();
        if (!reducedMotion.matches) requestAnimationFrame(animateMathField);
      }
    </script>
  </body>
</html>
